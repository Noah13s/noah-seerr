FROM node:22.23.2-alpine3.23@sha256:46825fbbd4e996a78b7a2cdc08d75e38a5a505bdab95dcda55605359bf124bc6

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml .npmrc ./
COPY next.config.ts next-env.d.ts postcss.config.js tailwind.config.js tsconfig.json seerr-api.yml ./
COPY bin ./bin
COPY public ./public
COPY src ./src
COPY server ./server

RUN pnpm install

CMD pnpm dev
